@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam defaultFontName PingFang SC
skinparam defaultFontSize 27
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 35
skinparam nodeBackgroundColor #EFF6FF
skinparam nodeBorderColor #1D4ED8
skinparam ArrowColor #1D4ED8
node "工作机器1" <<device>> as M1 {
 node "TaskManager 1" <<executionEnvironment>> as TM1 {
  artifact "作业代码" as Code1
 }
}
node "工作机器2" <<device>> as M2 {
 node "TaskManager 2" <<executionEnvironment>> as TM2 {
  artifact "作业代码" as Code2
 }
}
TM1 -- TM2 : 数据通道
note bottom of M1
 Slot 0：S0/F0、A0、O0
 Slot 1：A1
end note
note bottom of M2
 Slot 0：S1/F1、A2、O1
 Slot 1：A3
end note
@enduml
